{
  "name": "axon-desktop",
  "version": "0.1.0",
  "description": "AXON Desktop — AI-powered delivery pipelines",
  "author": "CommX Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.js",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.config.js",
    "build:all": "npm run build && electron-builder --win --mac --config electron-builder.config.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "@fontsource-variable/geist": "^5.2.9",
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.101.0",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "8.1.0",
    "lucide-react": "^0.477.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "shadcn": "^4.11.0",
    "simple-git": "^3.25.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^5.4.19"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
