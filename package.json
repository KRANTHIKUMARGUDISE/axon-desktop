{
  "name": "axon-desktop",
  "version": "0.1.0",
  "description": "AXON Desktop — AI-powered delivery pipelines",
  "author": "CommX Team",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.js",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build:all": "npm run build && electron-builder --win --mac --config electron-builder.config.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "8.1.0",
    "lucide-react": "^0.477.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.2",
    "simple-git": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^5.4.19",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
